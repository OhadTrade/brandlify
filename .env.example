# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Nothing that looks like a secret is ever
# hard-coded in the source — every value below is read from the environment.
# ---------------------------------------------------------------------------

# Supabase — project "brandlify" (ref kdlsprefdmvjhvelaebk, eu-central-1)
NEXT_PUBLIC_SUPABASE_URL=https://kdlsprefdmvjhvelaebk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
# Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# Transactional e-mail (stage 8)
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=hello@brandlify.co.il
# Optional. Defaults to no-reply@<NEXT_PUBLIC_SITE_URL hostname>, which Resend
# can only send from once that domain is verified. Until then set this to a
# verified sender, e.g. onboarding@resend.dev.
RESEND_FROM=

# Advertising email (section 30A). A campaign refuses to send without an
# address: the section requires the advertiser's name, address and contact
# details in every promotional message. A PO box or registered address is fine.
MARKETING_SENDER_NAME=
MARKETING_SENDER_ADDRESS=

# Site
NEXT_PUBLIC_SITE_URL=https://brandlify.co.il
NEXT_PUBLIC_WHATSAPP=972522174188
NEXT_PUBLIC_PHONE=052-217-4188

# Analytics (stage 10)
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile (stage 8)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
